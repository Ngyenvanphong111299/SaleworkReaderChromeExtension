{
  "manifest_version": 3,
  "name": "Salework Crawler",
  "version": "2.1",
  "description": "Tự động tìm kiếm và trích xuất tin nhắn từ Salework (v2.1 - Enhanced)",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.salework.net/*",
    "https://omnichannel.hoangkimeco.com/*"
  ],
  "background": {
    "service_worker": "js/05-background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Salework Crawler"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.salework.net/*"],
      "js": ["content/bundle.js"],
      "run_at": "document_idle"
    }
  ]
}
